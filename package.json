{
  "name": "wireon",
  "private": true,
  "version": "1.0.28",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:electron && npm run typecheck:preload",
    "gen:icon": "node scripts/gen-icon.mjs",
    "refresh:ytdlp": "node scripts/refresh-ytdlp.mjs",
    "electron:dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "electron:build": "npm run gen:icon && tsc && vite build && tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "smoke:build": "node scripts/smoke-build.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "smoke:sources": "node scripts/smoke-sources.mjs",
    "verify": "npm run typecheck:all && npm run test:coverage && npm run electron:build && npm run smoke:build && npm run smoke:boot",
    "release:prepare": "node scripts/release-prepare.mjs",
    "build:win": "npm run refresh:ytdlp && npm run electron:build && electron-builder --config electron-builder.cjs --win --x64",
    "check:binaries": "node scripts/check-platform-binaries.mjs",
    "build:linux": "npm run refresh:ytdlp && npm run electron:build && node scripts/check-platform-binaries.mjs --platform=linux && electron-builder --config electron-builder.cjs --linux AppImage --x64",
    "pack:win": "npm run electron:build && electron-builder --config electron-builder.cjs --dir",
    "release": "npm run refresh:ytdlp && npm run electron:build && electron-builder --config electron-builder.cjs --win nsis --x64 --publish always",
    "release:portable": "electron-builder --config electron-builder.cjs --win portable --x64 --publish always",
    "release:linux": "npm run refresh:ytdlp && npm run electron:build && node scripts/check-platform-binaries.mjs --platform=linux && electron-builder --config electron-builder.cjs --linux AppImage --x64 --publish always"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtube-dl-exec": "^3.1.12",
    "youtubei.js": "^18.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
