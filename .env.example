# Wireon — переменные окружения
#
# Скопируй этот файл в `.env` и подставь свои значения.
# `.env` и `.env.local` уже перечислены в .gitignore, поэтому настоящие
# значения не попадут в репозиторий.
#
# В рендерер Vite отдаёт только переменные с префиксом VITE_.

# OAuth2-приложение Discord ("Client ID" / "Application ID" в панели
# разработчика: https://discord.com/developers/applications).
#
# Переменная НЕ обязательна: в коде уже зашит Application ID самого Wireon
# (DEFAULT_DISCORD_CLIENT_ID в src/services/discordAuth.ts), поэтому вход
# работает и в собранном приложении без .env. Указывай эту переменную только
# если хочешь подключить своё приложение Discord.
#
# В настройках OAuth2 своего приложения добавь ОБА адреса перенаправления:
#   wireon://auth/callback                (собранное приложение — основной)
#   http://localhost:3000/auth/callback   (браузер / `npm run dev`)
#
# Почему именно wireon:// для приложения: используется implicit grant, токен
# приходит в hash-фрагменте адреса, а браузер фрагмент на сервер не отправляет —
# то есть localhost его физически не получит. Кастомную схему приложение
# получает целиком.
VITE_DISCORD_CLIENT_ID=

# ── Мобильная сборка (APK) ───────────────────────────────────────────────────
#
# Адрес и токен нашего сервера (`server/wireon_music`). Нужны ТОЛЬКО для APK: в
# Electron звук добывает главный процесс, и эти переменные не читаются вовсе.
#
# Обе или ни одной. Сервер отвечает 401 на всё, кроме `/health`, поэтому адрес
# без токена даёт приложение, где ни один трек не играет и никто не говорит
# почему — это хуже, чем ненастроенная сборка, где это видно сразу.
#
# Про токен честно: он попадает внутрь APK, а APK можно распаковать. Он не
# защищает пользователей друг от друга — он держит ручку, гоняющую yt-dlp,
# закрытой от всего интернета, чтобы с нашего адреса не резолвил кто попало.
VITE_WIREON_SERVER_URL=
VITE_WIREON_SERVER_TOKEN=

# Свой MQTT-брокер для «Слушать вместе» — он живёт в том же сервере, на пути
# `/mqtt`. Без этой переменной приложение идёт на публичные брокеры, которые
# режут соединения (пункт 4 списка). Токен здесь передаётся в адресе: браузерный
# WebSocket не умеет задавать заголовки, и сервер это принимает.
# Пример: ws://203.0.113.10:8099/mqtt?token=<токен>
VITE_WIREON_MQTT_URL=
